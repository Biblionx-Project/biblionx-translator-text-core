# Biblionx Translator Text Core Configuration

# RabbitMQ Message Broker Configuration
BIBLIONX_AMQP_HOST=localhost
AMQP_HOST=localhost
BIBLIONX_AMQP_PORT=5672
AMQP_PORT=5672
BIBLIONX_AMQP_USER=guest
AMQP_USER=guest
BIBLIONX_AMQP_PASS=guest
AMQP_PASS=guest
BIBLIONX_AMQP_PREFETCH_COUNT=1
AMQP_PREFETCH_COUNT=1
BIBLIONX_AMQP_HEART_BEAT=60
AMQP_HEART_BEAT=60

# Translation Worker Configuration
BIBLIONX_MODE=DEVELOPMENT
MODE=DEVELOPMENT
BIBLIONX_ENABLE_DL_TRANSLATION=True
ENABLE_DL_TRANSLATION=True
BIBLIONX_TRANSLATOR_QUEUE=translate.to_text
TRANSLATOR_QUEUE=translate.to_text
BIBLIONX_HEALTHCHECK_PORT=80
HEALTHCHECK_PORT=80
